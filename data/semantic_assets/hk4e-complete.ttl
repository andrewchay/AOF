@prefix bridge: <http://hk4e.mihoyo.com/bridge#> .
@prefix genshin: <http://genshin.mihoyo.com/ontology#> .
@prefix hk4e: <http://hk4e.mihoyo.com/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

genshin:belongsToRegion a owl:ObjectProperty ;
    rdfs:label "属于国度"@zh ;
    rdfs:domain genshin:PlayableCharacter ;
    rdfs:range genshin:Region .

genshin:hasDescription a owl:DatatypeProperty ;
    rdfs:label "详细描述"@zh ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string .

genshin:hasRarity a owl:DatatypeProperty ;
    rdfs:label "星级/稀有度"@zh ;
    rdfs:domain genshin:PlayableCharacter ;
    rdfs:range xsd:string .

genshin:hasWeaponType a owl:DatatypeProperty ;
    rdfs:label "武器类型"@zh ;
    rdfs:domain genshin:PlayableCharacter ;
    rdfs:range xsd:string .

genshin:interactsWith a owl:ObjectProperty ;
    rdfs:label "相互作用"@zh ;
    rdfs:domain genshin:GameElement ;
    rdfs:range genshin:GameElement .

genshin:isMemberOf a owl:ObjectProperty ;
    rdfs:label "属于组织"@zh ;
    rdfs:domain genshin:PlayableCharacter ;
    rdfs:range genshin:LoreFaction .

genshin:rulesOver a owl:ObjectProperty ;
    rdfs:label "统治/管理"@zh ;
    rdfs:domain genshin:LoreEntity ;
    rdfs:range genshin:Region .

genshin:triggersReaction a owl:ObjectProperty ;
    rdfs:label "触发反应"@zh ;
    rdfs:domain genshin:GameElement ;
    rdfs:range genshin:ElementalReaction .

genshin:wieldsElement a owl:ObjectProperty ;
    rdfs:label "使用元素"@zh ;
    rdfs:domain genshin:PlayableCharacter ;
    rdfs:range genshin:GameElement .

bridge:belongsToRegion a owl:ObjectProperty ;
    rdfs:label "属于国度"@zh ;
    rdfs:domain hk4e:Avatar ;
    rdfs:range genshin:Region .

bridge:isMemberOf a owl:ObjectProperty ;
    rdfs:label "属于组织"@zh ;
    rdfs:domain hk4e:Avatar ;
    rdfs:range genshin:LoreFaction .

bridge:wieldsElement a owl:ObjectProperty ;
    rdfs:label "使用元素"@zh ;
    rdfs:domain hk4e:Avatar ;
    rdfs:range genshin:GameElement .

<http://hk4e.mihoyo.com/ontology> a owl:Ontology ;
    rdfs:label "Genshin Impact (hk4e) Data Ontology"@en,
        "Genshin Impact Unified Ontology (Semantic + Data)"@en,
        "原神数据本体"@zh ;
    rdfs:comment "Extracted from CN warehouse metadata snapshot 2026-09-17 (1940 tables)."@en,
        "合并语义层(genshin_ontology.owl)与数据层(hk4e.ttl)"@zh .

hk4e:APPEARS_IN a owl:ObjectProperty ;
    rdfs:label "APPEARS_IN"@en ;
    rdfs:comment "card=N:1; via=scene_id"@en ;
    rdfs:domain hk4e:Boss ;
    rdfs:range hk4e:Scene .

hk4e:ATTEMPTS_DUNGEON_RUN a owl:ObjectProperty ;
    rdfs:label "ATTEMPTS_DUNGEON_RUN"@en ;
    rdfs:comment "card=1:N; via=uid"@en ;
    rdfs:domain hk4e:Player ;
    rdfs:range hk4e:DungeonRun .

hk4e:ATTEMPTS_ROLE_COMBAT_RUN a owl:ObjectProperty ;
    rdfs:label "ATTEMPTS_ROLE_COMBAT_RUN"@en ;
    rdfs:comment "card=1:N; via=uid"@en ;
    rdfs:domain hk4e:Player ;
    rdfs:range hk4e:RoleCombatRun .

hk4e:ATTEMPTS_TOWER_RUN a owl:ObjectProperty ;
    rdfs:label "ATTEMPTS_TOWER_RUN"@en ;
    rdfs:comment "card=1:N; via=uid"@en ;
    rdfs:domain hk4e:Player ;
    rdfs:range hk4e:TowerRun .

hk4e:Account_account_id a owl:DatatypeProperty ;
    rdfs:label "account_id"@en ;
    rdfs:comment "primary key"@en ;
    rdfs:domain hk4e:Account ;
    rdfs:range xsd:integer .

