    rdfs:comment "kind=Aggregate; domain=Combat; logical_name=tivat_battle_paper_towerdate_int; tables=1; notes=b9~b12 为 9~12 层及满层分档列；命名对齐兄弟分片 TivatBattlePaperTowerDateIntFix"@en ;
    rdfs:subClassOf <http://hk4e.mihoyo.com/ontology#Combat> .

