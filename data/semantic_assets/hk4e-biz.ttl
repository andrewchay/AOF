        "活跃玩家角色养成分布"@zh ;
    rdfs:comment "kind=Aggregate; domain=Combat; logical_name=avatar_build_bin_active; tables=1; notes=复用上轮命名；按 uid+日期+角色落库的养成 bin(等级/天赋/武器/圣遗物词条计数)，含大量 *_main 词条分桶"@en ;
    rdfs:subClassOf <http://hk4e.mihoyo.com/ontology#Combat> .

biz:LymActivity a owl:Class ;
    rdfs:label "LymActivity"@en,
        "活动参与画像宽表"@zh ;
    rdfs:comment "kind=Entity; domain=Player; logical_name=lym_activity; tables=1; notes=50 列宽表：等级/活跃天数/委托数/树脂消耗+多期小活动参与与奖励（minor_activity1~3）+深渊层数+角色持有+多角色挑战+音游(yinyou)系列列+委托(wq1~6)；'lym' 为作者标记"@en ;
    rdfs:subClassOf <http://hk4e.mihoyo.com/ontology#Player> .

