# AOF Semantic Middle Layer API - Environment Variables
# Copy this file to .env and fill in your values

# LLM Configuration (Required)
LLM_API_KEY=your-api-key-here
LLM_PROVIDER=custom
LLM_MODEL=deepseek/deepseek-chat
LLM_ENDPOINT=https://api.deepseek.com/v1

# Optional: Cognee path if using local installation
# COGNEE_ROOT=/path/to/cognee

# Application Settings
AOF_ROOT=/app/AOF
PYTHONUNBUFFERED=1

# Production Settings
# VERSION=1.0.0
# UVICORN_WORKERS=2
