<?xml version='1.0' encoding='UTF-8'?>
<rdf:RDF xmlns:ex="http://example.org/ontology#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
  <!-- TEST_DATA: SQL-only ontology for Miyoushe metrics (trimmed from mixed sample ontology) -->
  <rdf:Description rdf:about="http://example.org/ontology#DatabaseTable">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#SQLQuery">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:subClassOf rdf:resource="http://example.org/ontology#Query" />
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Metric">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#CommunityPlatform">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:subClassOf rdf:resource="http://example.org/ontology#Platform" />
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#usesTable">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:domain rdf:resource="http://example.org/ontology#SQLQuery" />
    <rdfs:range rdf:resource="http://example.org/ontology#DatabaseTable" />
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#definesMetric">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:domain rdf:resource="http://example.org/ontology#SQLQuery" />
    <rdfs:range rdf:resource="http://example.org/ontology#Metric" />
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#dim_community.dim_community_post_info_snapshot">
    <rdf:type rdf:resource="http://example.org/ontology#DatabaseTable" />
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#dwd_community.dwd_community_post_tag_item_df">
    <rdf:type rdf:resource="http://example.org/ontology#DatabaseTable" />
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#post_cnt_30d">
