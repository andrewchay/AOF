  <rdf:Description rdf:about="http://example.org/ontology#vertical_tag_post_cnt_yesterday">
    <rdf:type rdf:resource="http://example.org/ontology#Metric" />
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#quality_vertical_post_cnt_yesterday">
