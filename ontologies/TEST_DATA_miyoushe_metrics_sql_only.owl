    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#sql_query_1">
    <rdf:type rdf:resource="http://example.org/ontology#SQLQuery" />
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual" />
    <ex:usesTable rdf:resource="http://example.org/ontology#dim_community.dim_community_post_info_snapshot" />
    <ex:definesMetric rdf:resource="http://example.org/ontology#post_cnt_30d" />
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#sql_query_2">
    <rdf:type rdf:resource="http://example.org/ontology#SQLQuery" />
